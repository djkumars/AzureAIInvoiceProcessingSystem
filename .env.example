# Local persistence and private local blob fallback
DATABASE_PATH=./data/invoices.sqlite3
DATABASE_URL=
LOCAL_BLOB_DIR=./data/private-blobs
MAX_UPLOAD_BYTES=15728640
REVIEWER_API_KEY=replace-with-a-long-random-local-secret

# Configure Azure Blob using either a connection string or managed identity.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_BLOB_CONTAINER=invoices

# Azure AI Document Intelligence
DOCUMENT_INTELLIGENCE_ENDPOINT=
DOCUMENT_INTELLIGENCE_KEY=

# Azure OpenAI/LangChain. If not configured, typed deterministic fallback checks run.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=

# Adapter mode is intentionally mock/local by default; no real PO or finance endpoints.
PO_ADAPTER=mock
FINANCE_ADAPTER=mock
